# mount point    fstype  device                                   flags
/system_root     ext4    system                                   flags=display="System";logical;slotselect
/system_ext      ext4    system_ext                               flags=display="System_ext";logical;slotselect
/vendor          erofs   vendor                                   flags=display="Vendor";logical;slotselect
/product         ext4    product                                  flags=display="Product";logical;slotselect

/metadata        ext4    /dev/block/by-name/metadata              flags=display="Metadata"
/data            f2fs    /dev/block/by-name/userdata              flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/boot            emmc    /dev/block/by-name/boot                  flags=display="Boot";backup=1;flashimg=1;slotselect

/external_sd     vfat    /dev/block/mmcblk1p1 /dev/block/mmcblk1  flags=display="Micro SDcard";storage;wipeingui;removable
/usb_otg         vfat    /dev/block/sdb1 /dev/block/sdb           flags=display="USB-OTG";storage;wipeingui;removable
